# Throwaway configuration for the container smoke test in CI and on a laptop
# (deploy/compose.staging.yml with DEVCONTEXT_ENV_FILE=./env/ci.env). No value
# here is a real secret and the stack only binds to 127.0.0.1 without TLS,
# which is why APP_ENV is "preview" and INSECURE_HTTP_ORIGINS is set.
NODE_ENV=production
APP_ENV=preview
RELEASE=ci
API_HOST=0.0.0.0
API_PORT=4000
POSTGRES_USER=devcontext
POSTGRES_PASSWORD=devcontext-ci-only
POSTGRES_DB=devcontext
DATABASE_URL=postgresql://devcontext:devcontext-ci-only@postgres:5432/devcontext
DATABASE_POOL_MAX=5
CORS_ORIGIN=http://127.0.0.1:3100
BETTER_AUTH_URL=http://127.0.0.1:4100
BETTER_AUTH_SECRET=ci-only-secret-not-for-any-real-environment-0123456789
TRUST_PROXY=false
INSECURE_HTTP_ORIGINS=true
LOG_LEVEL=info
BILLING_PROVIDER=none
