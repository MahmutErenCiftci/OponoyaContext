# Production environment template (Handoff 12). Never commit the filled file;
# store values in the hosting provider's secret manager and inject them at
# runtime. Rotate BETTER_AUTH_SECRET by deploying the new value (all sessions
# are invalidated), rotate database credentials by updating DATABASE_URL and
# restarting, rotate provider keys at the provider first.
NODE_ENV=production
APP_ENV=production
RELEASE=<git-sha-or-tag>
API_HOST=0.0.0.0
API_PORT=4000

# Managed PostgreSQL with TLS; the application user must own the schema (migrations) but not be a superuser.
DATABASE_URL=postgresql://<user>:<password>@<managed-host>:5432/<database>?sslmode=verify-full
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Exact public origins; both must be HTTPS (startup refuses anything else).
CORS_ORIGIN=https://<web-host>
BETTER_AUTH_URL=https://<api-host>
BETTER_AUTH_SECRET=<openssl rand -base64 48>
# true trusts only private-network peers (the platform load balancer); or list its IPs/CIDR ranges.
TRUST_PROXY=true
# Same value on the API and the web service (the web proxy asserts client addresses with it). Required.
WEB_PROXY_SECRET=<openssl rand -base64 48>
INSECURE_HTTP_ORIGINS=false
LOG_LEVEL=info

BILLING_PROVIDER=none
# BILLING_WEBHOOK_SECRET=
# BILLING_SECRET_KEY=
# BILLING_PRO_PRICE_ID=
# BILLING_PRO_PRICE_LABEL=

# SENTRY_DSN=
# ERROR_REPORTING_URL=
# ERROR_REPORTING_TOKEN=

# Password reset stays off until the owner wires a real e-mail provider ("log" is refused here).
EMAIL_PROVIDER=none

# AI suggestions stay off until the owner activates a provider and updates the Privacy text and subprocessors.
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=

# Legal values are owner/legal decisions; the pages stay drafts until every key and LEGAL_APPROVED_AT are set.
# LEGAL_ENTITY_NAME=
# LEGAL_ENTITY_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# LEGAL_JURISDICTION=
# LEGAL_EFFECTIVE_DATE=
# LEGAL_APPROVED_AT=
# LEGAL_SUBPROCESSORS=
# HOSTING_REGION=
# BACKUP_RETENTION_DAYS=
# BILLING_RECORDS_RETENTION_YEARS=
