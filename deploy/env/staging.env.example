# Staging environment for deploy/compose.staging.yml (Handoff 12).
# Copy to deploy/env/staging.env (git-ignored) and replace every <…> value.
# Generate secrets with:  openssl rand -base64 48   (never reuse production values)
NODE_ENV=production
APP_ENV=staging
RELEASE=<git-sha-or-tag>
API_HOST=0.0.0.0
API_PORT=4000

# PostgreSQL inside the stack (the API reaches it as "postgres").
POSTGRES_USER=devcontext
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=devcontext
DATABASE_URL=postgresql://devcontext:<same POSTGRES_PASSWORD>@postgres:5432/devcontext
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Public origins: the web app and the API as browsers see them (HTTPS behind the TLS terminator).
CORS_ORIGIN=https://<staging-web-host>
BETTER_AUTH_URL=https://<staging-api-host>
BETTER_AUTH_SECRET=<openssl rand -base64 48>
# true only when a load balancer overwrites X-Forwarded-For in front of the API.
TRUST_PROXY=true
# Only for a stack without TLS (laptop / CI); refused when APP_ENV=production.
INSECURE_HTTP_ORIGINS=false
LOG_LEVEL=info

# Billing: none until the owner activates a provider (docs/40_BILLING_HANDOFF.md).
BILLING_PROVIDER=none
# BILLING_WEBHOOK_SECRET=
# BILLING_SECRET_KEY=
# BILLING_PRO_PRICE_ID=
# BILLING_PRO_PRICE_LABEL=

# Error reporting: one of the two (content-free summaries only).
# SENTRY_DSN=
# ERROR_REPORTING_URL=
# ERROR_REPORTING_TOKEN=

# Legal placeholders (docs/42_PRIVACY_ACCOUNT_HANDOFF.md); unset keys render as "belirlenmedi".
# LEGAL_ENTITY_NAME=
# LEGAL_ENTITY_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# LEGAL_JURISDICTION=
# LEGAL_EFFECTIVE_DATE=
# LEGAL_APPROVED_AT=
# LEGAL_SUBPROCESSORS=
# HOSTING_REGION=
# BACKUP_RETENTION_DAYS=
# BILLING_RECORDS_RETENTION_YEARS=
