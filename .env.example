NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
API_URL=http://localhost:4000
DATABASE_URL=postgresql://devcontext:devcontext@localhost:5432/devcontext
CORS_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Which peers may set X-Forwarded-For for the API: false (use the socket
# address), true (private-network peers only: loopback, link-local, RFC 1918 /
# unique-local, i.e. a platform load balancer) or an explicit comma-separated
# list of IPs/CIDR ranges. A client on the internet can never pick its address.
TRUST_PROXY=false
# Shared by the API and the web app (at least 32 characters). The web proxy
# presents it together with the end-user address, so anonymous rate limits
# (sign-in, sign-up) apply per client instead of to the web server as a whole.
# Required when APP_ENV=production; set the same value on both services.
# WEB_PROXY_SECRET=replace-with-at-least-32-random-characters
# Optional log level override: fatal|error|warn|info|debug|trace|silent
# (defaults: production info, development debug, test silent).
# LOG_LEVEL=info
# Billing (Handoff 10). "none" keeps everyone on the Free plan with no upgrade
# path; "fake" enables the in-process test provider (development/test only);
# "stripe" is reserved for the real adapter and is refused until it ships.
# The webhook secret signs provider events and must be at least 32 characters.
# BILLING_SECRET_KEY and BILLING_PRO_PRICE_ID are server-only and belong to the
# real provider; BILLING_PRO_PRICE_LABEL is display text such as "9 USD / month".
BILLING_PROVIDER=none
# BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# BILLING_SECRET_KEY=
# BILLING_PRO_PRICE_ID=
# BILLING_PRO_PRICE_LABEL=
# Legal surfaces (Handoff 11). Every value is optional; while one is missing the
# Terms and Privacy pages show an explicit "not set" placeholder and stay marked
# as drafts. Never invent these: they are owner/legal decisions.
# LEGAL_ENTITY_NAME=
# LEGAL_ENTITY_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# LEGAL_JURISDICTION=
# Dates are YYYY-MM-DD. LEGAL_APPROVED_AT is set only after the legal review.
# LEGAL_EFFECTIVE_DATE=
# LEGAL_APPROVED_AT=
# Comma-separated processor names, e.g. "Hosting provider, Payment provider".
# LEGAL_SUBPROCESSORS=
# HOSTING_REGION=
# BACKUP_RETENTION_DAYS=
# BILLING_RECORDS_RETENTION_YEARS=
# Operations (Handoff 12). APP_ENV tags logs/error reports and separates
# preview/staging from production (defaults to NODE_ENV); RELEASE is the build id.
# APP_ENV=development
# RELEASE=
# Error reporting: a Sentry DSN (store endpoint, no SDK) or a JSON webhook.
# SENTRY_DSN=
# ERROR_REPORTING_URL=
# ERROR_REPORTING_TOKEN=
# Bounded pool per API instance and statement timeout; drain window after SIGTERM.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=5000
# SHUTDOWN_TIMEOUT_MS=10000
# Allow plain-HTTP origins for a production build without TLS (preview/staging only; refused when APP_ENV=production).
# INSECURE_HTTP_ORIGINS=false
# AI suggestions (V1.5 groundwork, off by default). "none" keeps every AI route
# answering ai_unavailable and nothing leaves the API; "fake" is a deterministic
# local provider (never in production); "anthropic" calls Claude with the
# server-only AI_API_KEY. Enabling a real provider is an owner decision that
# also needs the Privacy text and LEGAL_SUBPROCESSORS updated.
# AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=claude-opus-5
# Optional output effort (low|medium|high|xhigh|max); unset keeps the model default.
# AI_EFFORT=
# AI_TIMEOUT_MS=120000
# AI_MAX_OUTPUT_TOKENS=16000
# Transactional e-mail for password reset. "none" keeps reset off; "log" (development
# only) writes the reset link to the API log and, with EMAIL_OUTBOX_FILE, to a local file.
# EMAIL_PROVIDER=log
# EMAIL_OUTBOX_FILE=.local/outbox.jsonl
