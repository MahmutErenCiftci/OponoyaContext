{
  "name": "@devcontext/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "node scripts/generate.mjs && tsc --noEmit",
    "lint": "node scripts/generate.mjs && eslint .",
    "test": "node scripts/generate.mjs && vitest run",
    "build": "node scripts/generate.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@devcontext/contracts": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
