{
  "name": "@devcontext/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@devcontext/catalog": "workspace:*",
    "@devcontext/context-compiler": "workspace:*",
    "@devcontext/contracts": "workspace:*",
    "@devcontext/db": "workspace:*",
    "@fastify/cors": "11.3.0",
    "better-auth": "1.7.3",
    "fastify": "5.12.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.0"
  }
}
