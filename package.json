{
  "name": "devcontext-os",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo build",
    "lint": "eslint scripts e2e playwright.config.ts && turbo lint",
    "typecheck": "tsc --noEmit && turbo typecheck",
    "test": "turbo test",
    "db:generate": "node scripts/run.mjs --filter @devcontext/db db:generate",
    "db:migrate": "node scripts/run.mjs --filter @devcontext/db db:migrate",
    "dev:apps": "node scripts/run.mjs exec turbo dev",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:db": "node scripts/run.mjs --filter @devcontext/db --filter @devcontext/api test:integration",
    "db:backup": "node scripts/run.mjs --filter @devcontext/db db:backup",
    "db:restore": "node scripts/run.mjs --filter @devcontext/db db:restore",
    "db:verify": "node scripts/run.mjs --filter @devcontext/db db:verify",
    "db:retention": "node scripts/run.mjs --filter @devcontext/db db:retention",
    "smoke": "node scripts/smoke.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "turbo": "2.10.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0"
  }
}
